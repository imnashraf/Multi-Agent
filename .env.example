# Configurable LLM Provider Settings (no paid travel API keys required)
# Primary Agents (Orchestrator, Destination Research, Logistics, Budget): Groq OSS-120B
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
GROQ_API_KEY=your-groq-api-key-here

# Review Agent: Google Gemini
REVIEW_LLM_PROVIDER=google_genai
REVIEW_LLM_MODEL=gemini-3.8-flash
REVIEW_LLM_TEMPERATURE=0.1
GOOGLE_API_KEY=your-google-api-key-here

# Optional alternative provider overrides
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_API_KEY=
# REVIEW_LLM_API_KEY=
# LLM_BASE_URL=

# Workflow & Data Settings
MAX_REVISIONS=2
OFFLINE_MODE=false
